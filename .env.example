# Copy to .env and fill in (never commit .env)
# SeedHost SFTP → rclone mount (ebook qBittorrent category)

SEEDHOST_SFTP_HOST=city.seedhost.eu
SEEDHOST_SFTP_USER=harenix
SEEDHOST_SFTP_PASSWORD=

# Path on SeedHost relative to SFTP login home (/home16/harenix)
# Full qBittorrent save path: /home16/harenix/downloads/ebooks
SEEDHOST_SFTP_REMOTE_PATH=downloads/ebooks

SEEDHOST_MOUNT_POINT=/mnt/seedhost-ebooks
SEEDHOST_CONTAINER_PATH=/home16/harenix/downloads/ebooks

# Optional: SSH key instead of password
# SEEDHOST_SFTP_KEY_FILE=/opt/ebooks/shelfmark/rclone/id_ed25519_seedhost

# Existing Prowlarr (stack-audiobooks, lab 192.168.2.4)
PROWLARR_API_KEY=

# Remote SeedHost qBittorrent (Web UI)
# Use $$ for each literal $ in passwords (Docker Compose .env interpolation)
QBITTORRENT_URL=https://city.seedhost.eu/harenix/qbittorrent/
QBITTORRENT_USERNAME=harenix
QBITTORRENT_PASSWORD=

# Pocket ID OIDC — Shelfmark (create client at id.cvss.io)
SHELFMARK_OIDC_CLIENT_ID=
SHELFMARK_OIDC_CLIENT_SECRET=

# Promote this Pocket ID email to Shelfmark admin after first SSO login
SHELFMARK_ADMIN_EMAIL=gregdogknell@gmail.com

# Promote this Pocket ID email to BookOrbit superuser on deploy
BOOKORBIT_ADMIN_EMAIL=gregdogknell@gmail.com

# Family OIDC (Pocket ID group friendly name → BookOrbit permission)
BOOKORBIT_MEDIA_OIDC_GROUP=media-users
BOOKORBIT_FAMILY_PERMISSION=library_download
# BOOKORBIT_DEFAULT_LIBRARY_ID=1

# BookOrbit secrets (generate: openssl rand -hex 32 / openssl rand -hex 16)
BOOKORBIT_POSTGRES_USER=bookorbit
BOOKORBIT_POSTGRES_PASSWORD=
BOOKORBIT_POSTGRES_DB=bookorbit
BOOKORBIT_JWT_SECRET=
BOOKORBIT_SETUP_BOOTSTRAP_TOKEN=

# Optional image pin
# BOOKORBIT_IMAGE=ghcr.io/bookorbit/bookorbit:latest

# BookOrbit Send-to-Kindle — configure in admin UI (Settings → Email), not here.
# Placeholders for documentation:
# KINDLE_FROM_EMAIL=your-verified-sender@example.com
# KINDLE_TO_EMAIL=yourname@kindle.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
